#!/bin/bash

set -euo pipefail

readonly max_bytes=$((1024 * 1024))
article_url=${1:-}

if [[ ! $article_url =~ ^https://(www\.)?omarchy\.org/news/[0-9]{4}/[0-9]{2}/[a-z0-9][a-z0-9-]*/?$ ]]; then
  printf 'Invalid Omarchy News article URL\n' >&2
  exit 2
fi

article_url="${article_url%/}/"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

curl \
  --fail \
  --silent \
  --show-error \
  --proto '=https' \
  --connect-timeout 5 \
  --max-time 15 \
  --max-filesize "$max_bytes" \
  --user-agent 'io.github.thelost77.omacourier/1.0' \
  --output "$tmp" \
  "$article_url"

size=$(stat -c '%s' "$tmp")
if (( size == 0 || size > max_bytes )); then
  printf 'Omarchy News article has an invalid size: %s bytes\n' "$size" >&2
  exit 1
fi

cat "$tmp"
